{
  "name": "book-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "cd .. && husky .husky",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/sync-pdfium-assets.mjs && node scripts/sync-djvujs-assets.mjs",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated/schema.ts",
    "build": "node scripts/sync-pdfium-assets.mjs && node scripts/sync-djvujs-assets.mjs && npm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/models": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@floating-ui/dom": "^1.7.6",
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-query": "^5.101.2",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.23.0",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.14",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "storybook": "^10.4.6",
    "storybook-solidjs-vite": "^10.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.1.11",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  }
}
