server {
    listen 80;
    server_name _;
    root __STATIC_ROOT__;

    client_max_body_size __MAX_BODY_SIZE__;

    location ^~ __API_PREFIX__/ {
        proxy_pass __BACKEND_URL__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix __FORWARDED_PREFIX__;
    }

    location = __BASE_PATH__ {
        return 308 __BASE_PATH__/;
    }

    location ^~ __BASE_PATH__/assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        error_page 404 = @missing_asset;
    }

    location @missing_asset {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location ^~ __BASE_PATH__/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        etag off;
        if_modified_since off;
        try_files $uri $uri/ __BASE_PATH__/index.html;
    }

    location / {
        return 404;
    }
}
