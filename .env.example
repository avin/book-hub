# PostgreSQL only; SQLite installations may remove these three settings.
POSTGRES_DB=bookhub
POSTGRES_USER=bookhub
POSTGRES_PASSWORD=change-me

BOOK_HUB_PUBLIC_PORT=8080
BOOK_HUB_HTTP_ADDR=:8080
BOOK_HUB_BASE_PATH=/
# Optional public production build for direct server runs; empty keeps API-only mode.
# Absolute path or relative to the process working directory; not read by CLI tools.
BOOK_HUB_FRONTEND_DIR=
BOOK_HUB_LOG_LEVEL=info
BOOK_HUB_DATABASE_URL=postgres://bookhub:change-me@postgres:5432/bookhub?sslmode=disable
# SQLite alternative (one backend, local disk): sqlite:///data/db/book-hub.sqlite
BOOK_HUB_STORAGE_DIR=/data/books
# Optional separate directories; empty values preserve the legacy layout below STORAGE_DIR.
BOOK_HUB_BOOK_STORAGE=directory
# FTP/FTPS originals: select ftp, ftps-explicit or ftps-implicit above; use a dedicated absolute directory, credentials stay server-side.
BOOK_HUB_FTP_ADDR=
BOOK_HUB_FTP_USER=
BOOK_HUB_FTP_PASSWORD=
BOOK_HUB_FTP_ROOT=/books
# Optional additional trusted CA PEM for FTPS; certificate and hostname verification stay enabled.
BOOK_HUB_FTP_CA_FILE=

# S3 originals: select s3 above; empty endpoint uses Amazon S3 for the configured region.
BOOK_HUB_S3_ENDPOINT=
BOOK_HUB_S3_REGION=
BOOK_HUB_S3_BUCKET=
BOOK_HUB_S3_PREFIX=books
BOOK_HUB_S3_ACCESS_KEY_ID=
BOOK_HUB_S3_SECRET_ACCESS_KEY=
BOOK_HUB_BOOKS_DIR=
BOOK_HUB_IMAGES_DIR=
BOOK_HUB_WORK_DIR=
# Shared temporary upload/retrieval budget per backend (1 GiB); backup space is separate.
BOOK_HUB_WORK_MAX_BYTES=1073741824
# Optional persistent book cache: both values are required; empty means disabled.
BOOK_HUB_CACHE_DIR=
BOOK_HUB_CACHE_MAX_BYTES=
BOOK_HUB_DEFAULT_QUOTA_BYTES=2147483648
BOOK_HUB_REGISTRATION_ENABLED=true
BOOK_HUB_REGISTRATION_AUTO_ACTIVATE=false
BOOK_HUB_MAX_UPLOAD_BYTES=314572800
BOOK_HUB_MAX_COVER_UPLOAD_BYTES=1048576
BOOK_HUB_SESSION_SECRET=change-me-long-random-secret-value
BOOK_HUB_SESSION_TTL=26280h
BOOK_HUB_COOKIE_SECURE=false
